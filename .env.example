# Número de WhatsApp que receberá os contatos do site.
# Formato internacional: código do país + DDD + número, somente dígitos.
# Exemplo fictício para o Brasil: 5595999999999 (55 + 95 + número)
# O site abre uma conversa com a mensagem preenchida; o visitante confirma o envio no WhatsApp.
# Não é necessário token nem configuração da API do WhatsApp para este tipo de link.
NEXT_PUBLIC_WHATSAPP_NUMBER=5595999999999
